import("//build/buildflag_header.gni")
import("//neutron/buildflags/buildflags.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"

  flags = [
    "ENABLE_PDF_VIEWER=$enable_pdf_viewer",
    "ENABLE_ELECTRON_EXTENSIONS=$enable_neutron_extensions",
    "ENABLE_BUILTIN_SPELLCHECKER=$enable_builtin_spellchecker",
    "OVERRIDE_LOCATION_PROVIDER=$enable_fake_location_provider",
  ]

  if (neutron_vendor_version != "") {
    result = string_split(neutron_vendor_version, ":")
    flags += [
      "HAS_VENDOR_VERSION=true",
      "VENDOR_VERSION_NAME=\"${result[0]}\"",
      "VENDOR_VERSION_VALUE=\"${result[1]}\"",
    ]
  } else {
    flags += [ "HAS_VENDOR_VERSION=false" ]
  }
}
