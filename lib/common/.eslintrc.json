{
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          "neutron",
          "neutron/main",
          "neutron/renderer"
        ],
        "patterns": [
          "./*",
          "../*",
          "@neutron/internal/browser/*",
          "@neutron/internal/isolated_renderer/*",
          "@neutron/internal/renderer/*",
          "@neutron/internal/sandboxed_worker/*",
          "@neutron/internal/worker/*"
        ]
      }
    ]
  }
}
